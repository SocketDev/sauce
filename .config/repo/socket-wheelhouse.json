{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "sauce",
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "npm-registry",
    "type": "js"
  },
  "fuzz": {
    "exempt": true,
    "reason": "The release-kit payload's pure parsers (brew formula rewrite, npm access/trusted-publisher/staged page parsers, the pnpm-workspace catalog editor, and the installer manifest/path-safety + byte-parity checker) ARE covered by Tier-1 fast-check property suites under test/repo/unit/release-kit/fuzz/*.fuzz.test.mts. The Tier-2 vitiate coverage-guided lane (*.fuzz.ts) is not adopted: vitiate is not a catalog dependency here, and the skills content tooling itself parses only repo-tracked SKILL.md/marketplace.json, never untrusted input."
  },
  "hooks": {
    "enablePrePush": true,
    "enableCommitMsg": true,
    "enablePreCommit": true,
    "preCommitVariant": "lint-test"
  },
  "scripts": {
    "optional": {
      "check": true,
      "clean": false,
      "cover": false,
      "fix": true,
      "security": true,
      "setup": false,
      "type": false,
      "update": true
    }
  },
  "lint": {
    "profile": "standard"
  },
  "workflows": {
    "ci": true,
    "provenance": false,
    "requirePinnedFullSha": true,
    "weeklyUpdate": true
  },
  "claude": {
    "includeSecurityScanSkill": true,
    "includeSharedSkills": true,
    "includeUpdatingSkill": true
  },
  "vitest": {
    "nodeTestExclude": ["tests/fixtures/**"]
  },
  "workspace": {
    "blockExoticSubdeps": true,
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": ["@socketregistry/*", "@socketsecurity/*"],
    "resolutionMode": "highest",
    "trustPolicy": "no-downgrade"
  },
  "bundle": {
    "ref": "fleet-pack-b12f764b31ec17f8f08ab5a49c21c3852e46a385",
    "cascadeSha": "b12f764b31ec17f8f08ab5a49c21c3852e46a385"
  },
  "coverage": {
    "include": ["release-kit/**/*.mts", "release-kit/**/*.mjs"],
    "exclude": {
      "add": [
        "release-kit/examples/**",
        "release-kit/**/*.d.mts",
        "release-kit/payload/scripts/socket-release/templates/**"
      ]
    }
  },
  "bornTested": {
    "grandfathered": [
      "scripts/repo/ai-lint-fix.mts",
      "scripts/repo/ai-lint-fix/cli.mts",
      "scripts/repo/audit-transcript.mts",
      "scripts/repo/check-paths.mts",
      "scripts/repo/check-paths/cli.mts",
      "scripts/repo/check-prompt-less-setup.mts",
      "scripts/repo/check-soak-exclude-dates.mts",
      "scripts/repo/check/release-kit-is-coherent.mts",
      "scripts/repo/check/release-kit-launches-are-sanctioned.mts",
      "scripts/repo/check/release-kit-types-resolve.mts",
      "scripts/repo/check/release-kit-workflows-are-env-mapped.mts",
      "scripts/repo/clean.mts",
      "scripts/repo/fix.mts",
      "scripts/repo/generate-agents.mts",
      "scripts/repo/git-partial-submodule.mts",
      "scripts/repo/helpers/parse-dependencies.mts",
      "scripts/repo/helpers/search-usage.mts",
      "scripts/repo/inline-shared.mts",
      "scripts/repo/install-sfw.mts",
      "scripts/repo/install-token-minifier.mts",
      "scripts/repo/janus.mts",
      "scripts/repo/lint.mts",
      "scripts/repo/lockstep-emit-schema.mts",
      "scripts/repo/lockstep.mts",
      "scripts/repo/lockstep/cli.mts",
      "scripts/repo/lockstep/emit-schema.mts",
      "scripts/repo/publish.mts",
      "scripts/repo/security.mts",
      "scripts/repo/socket-wheelhouse-emit-schema.mts",
      "scripts/repo/test.mts",
      "scripts/repo/update.mts",
      "scripts/repo/validate-bundle-deps.mts",
      "scripts/repo/validate-config-paths.mts",
      "scripts/repo/validate-esbuild-minify.mts",
      "scripts/repo/validate-file-count.mts",
      "scripts/repo/validate-file-size.mts",
      "scripts/repo/validate-no-link-deps.mts",
      "scripts/repo/validate-rolldown-minify.mts"
    ]
  }
}
