{
  "name": "socket-skills",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "node scripts/publish.mts",
    "generate:check": "node scripts/publish.mts --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:api": "SOCKET_API_TOKEN=${SOCKET_API_TOKEN} vitest run --config tests/vitest.config.ts tier2-api/",
    "test:e2e": "RUN_E2E=1 vitest run --config tests/vitest.config.ts tier3-e2e/",
    "test:integration": "RUN_E2E=1 vitest run --config tests/vitest.config.ts tier3-e2e/",
    "test:integration:claude": "TEST_AGENT=claude-code pnpm run test:integration",
    "test:integration:codex": "TEST_AGENT=codex pnpm run test:integration",
    "test:integration:gemini": "TEST_AGENT=gemini pnpm run test:integration",
    "test:structural": "vitest run --config tests/vitest.config.ts tier1-structural/"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "0.37.0",
    "oxlint": "1.53.0",
    "tsx": "4.19.0",
    "typescript": "5.9.2",
    "vitest": "4.0.3"
  }
}
