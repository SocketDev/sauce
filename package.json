{
  "name": "socket-skills",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "node scripts/publish.mts",
    "check": "node scripts/check.mts",
    "check:paths": "node scripts/check-paths.mts",
    "clean": "node scripts/clean.mts",
    "cover": "vitest run --config tests/vitest.config.mts --coverage",
    "fix": "node scripts/fix.mts",
    "format": "oxfmt -c .config/oxfmtrc.json --write .",
    "format:check": "oxfmt -c .config/oxfmtrc.json --check .",
    "generate": "node scripts/publish.mts",
    "generate:check": "node scripts/publish.mts --check",
    "lint": "node scripts/lint.mts",
    "lint:fix": "node scripts/lint.mts --fix",
    "lockstep": "node scripts/lockstep.mts",
    "lockstep:emit-schema": "node scripts/lockstep-emit-schema.mts",
    "prepare": "node scripts/install-git-hooks.mts",
    "security": "node scripts/security.mts",
    "test": "node scripts/test.mts",
    "test:api": "SOCKET_API_TOKEN=${SOCKET_API_TOKEN} vitest run --config tests/vitest.config.mts tier2-api/",
    "test:e2e": "RUN_E2E=1 vitest run --config tests/vitest.config.mts tier3-e2e/",
    "test:integration": "RUN_E2E=1 vitest run --config tests/vitest.config.mts tier3-e2e/",
    "test:integration:claude": "TEST_AGENT=claude-code pnpm run test:integration",
    "test:integration:codex": "TEST_AGENT=codex pnpm run test:integration",
    "test:integration:gemini": "TEST_AGENT=gemini pnpm run test:integration",
    "test:structural": "vitest run --config tests/vitest.config.mts tier1-structural/",
    "update": "node scripts/update.mts",
    "setup-security-tools": "node .claude/hooks/setup-security-tools/install.mts"
  },
  "devDependencies": {
    "@sinclair/typebox": "catalog:",
    "@socketsecurity/lib": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260415.1",
    "oxfmt": "0.37.0",
    "oxlint": "1.53.0",
    "taze": "19.9.2",
    "tsx": "4.19.0",
    "typescript": "5.9.2",
    "vitest": "4.0.3"
  }
}
