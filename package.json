{
  "name": "sauce",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/repo/publish.mts",
    "check": "node scripts/repo/check.mts",
    "cover": "vitest run --config .config/repo/vitest.config.mts --coverage",
    "fix": "pnpm run lint:fix && pnpm run format",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "node scripts/repo/publish.mts",
    "generate:check": "node scripts/repo/publish.mts --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "node scripts/repo/install-git-hooks.mts",
    "prepublishOnly": "echo 'ERROR: Use GitHub Actions workflow for publishing' && exit 1",
    "test": "vitest run --config .config/repo/vitest.config.mts",
    "test:api": "SOCKET_API_TOKEN=${SOCKET_API_TOKEN} vitest run --config tests/vitest.config.mts tier2-api/",
    "test:e2e": "RUN_E2E=1 vitest run --config tests/vitest.config.mts tier3-e2e/",
    "test:fuzz-harnesses": "TEST_FUZZ=1 vitest run --config .config/repo/vitest.config.mts",
    "test:integration": "RUN_E2E=1 vitest run --config tests/vitest.config.mts tier3-e2e/",
    "test:integration:claude": "TEST_AGENT=claude-code pnpm run test:integration",
    "test:integration:codex": "TEST_AGENT=codex pnpm run test:integration",
    "test:integration:gemini": "TEST_AGENT=gemini pnpm run test:integration",
    "test:structural": "vitest run --config .config/repo/vitest.config.mts test/repo/unit/structural",
    "type": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p .config/repo/tsconfig.release-kit.json"
  },
  "devDependencies": {
    "@sinclair/typebox": "catalog:",
    "@socketsecurity/lib": "catalog:",
    "@socketsecurity/lib-stable": "catalog:",
    "@socketsecurity/sdk": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": ">=12.2.0",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": ">=12.12.0",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12.2.0",
    "pnpm": ">=12.12.0"
  },
  "allowScripts": {
    "cpu-features": false,
    "protobufjs": false,
    "puppeteer": false,
    "ssh2": false
  }
}
